# ============================================================
# Cloudflare DDNS - File cấu hình bảo mật
# Sao chép file này thành .env và điền thông tin thực tế.
# TUYỆT ĐỐI KHÔNG commit file .env lên Git!
# ============================================================

# --- Cloudflare (BẮT BUỘC) ---
CLOUDFLARE_API_TOKEN=your_api_token_here
ZONE_ID=your_zone_id_here  
DOMAIN=yourdomain.com

# Bật proxy Cloudflare (true = màu cam, false = DNS only / màu xám)
PROXIED=false

# ============================================================
# SUBDOMAINS - Danh sách subdomains cần cập nhật
# Format: JSON array ["sub1", "sub2", ...]
# ============================================================
SUBDOMAINS=["bz","rt","owncast","re","nc","home","tor","ptainer","uptime","adguard","npm"]

# ============================================================  
# CRON JOB CONFIGURATION (LINH HOẠT! - KHÔNG cần rebuild khi thay đổi)
# ============================================================
# Format: minute hour day month weekday command
# Ví dụ các giá trị phổ biến:
#   */5 * * * *    → Mỗi 5 phút (mặc định) ⚡ KHUYẾN DÙNG
#   */10 * * * *   → Mỗi 10 phút  
#   */15 * * * *   → Mỗi 15 phút
#   0 * * * *      → Mỗi giờ (phút 0)
#   0 */2 * * *    → Mỗi 2 giờ 
#   0 8 * * *      → Mỗi ngày lúc 8 AM sáng
#   30 2 * * *     → Mỗi ngày lúc 2:30 AM
CRON_EXPR="*/5 * * * *"

# ============================================================
# DISCORD & TELEGRAM NOTIFICATIONS (TUÝ CHỌN)
# ============================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here  
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

